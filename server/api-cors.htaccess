# ---------------------------------------------------------------------------
# Sales Reporter — allow the app on GitHub Pages (gajananhs.github.io) to
# call this API.  Upload as:  public_html/Salesreport1/api/.htaccess
#
# Plain fixed values only (no variables) so it works on LiteSpeed/Hostinger.
# It only adds response headers; no PHP file, data or logic is changed.
# Same-site pages (canaresonline.com, incl. TallyField) are unaffected:
# browsers only check these headers for requests from another site.
# ---------------------------------------------------------------------------

<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "https://gajananhs.github.io"
  Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, X-Session-Token"
  Header always set Access-Control-Max-Age "600"
</IfModule>

# Browser pre-check (OPTIONS): answer OK without running PHP
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^ - [R=204,L]
</IfModule>
